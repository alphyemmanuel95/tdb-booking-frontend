# Copy to .env.local and adjust. Only variables prefixed with VITE_ are exposed to the browser,
# so never put secrets here.

# Base URL for API requests made by RTK Query. Relative paths resolve against the app origin.
VITE_API_BASE_URL=/api

# Optional: backend URL that the Vite dev server proxies /api requests to (dev only, not bundled).
# VITE_DEV_PROXY_TARGET=http://localhost:8080
